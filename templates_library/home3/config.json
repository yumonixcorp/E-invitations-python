{
  "name": "Rose Frame",
  "category": "Wedding",
  "order": 3,
  "description": "Elegant line frames and coral roses, arched portrait, countdown rings, story circles and a Thank You footer.",
  "share_title": "{{bride_name}} & {{groom_name}} · Wedding Invitation",
  "share_description": "We are getting married · {{wedding_date}}",
  "map_query_fields": ["event_1_location"],
  "groups": {
    "cover": "Cover",
    "couple": "Bride & Groom",
    "story": "Our Story",
    "gallery": "Gallery",
    "people": "Bridesmaids & Groomsmen",
    "rsvp": "RSVP",
    "events": "When & Where",
    "closing": "Closing & Footer"
  },
  "editable_fields": {
    "bride_name": {"type": "text", "group": "cover", "label": "Bride name", "required": true, "max_length": 30, "sample": "Meera"},
    "groom_name": {"type": "text", "group": "cover", "label": "Groom name", "required": true, "max_length": 30, "sample": "Arjun"},
    "hero_subtitle": {"type": "text", "group": "cover", "label": "Subtitle", "max_length": 60, "sample": "We Are Getting Married"},
    "wedding_date": {"type": "date", "group": "cover", "label": "Wedding date", "required": true, "sample": "2027-03-13"},
    "wedding_time": {"type": "time", "group": "cover", "label": "Muhurtham time (for the countdown)", "sample": "06:30"},
    "hero_image": {"type": "image", "group": "cover", "label": "Cover photo (portrait, shown in an arch)"},
    "bride_full_name": {"type": "text", "group": "couple", "label": "Bride full name", "max_length": 40, "sample": "Meera Pillai"},
    "bride_bio": {"type": "textarea", "group": "couple", "label": "About the bride", "max_length": 300, "sample": "A cheerful soul who loves music, filter coffee and long evening walks by the sea."},
    "bride_instagram": {"type": "url", "group": "couple", "label": "Bride Instagram link (optional)"},
    "bride_facebook": {"type": "url", "group": "couple", "label": "Bride Facebook link (optional)"},
    "groom_full_name": {"type": "text", "group": "couple", "label": "Groom full name", "max_length": 40, "sample": "Arjun Nair"},
    "groom_bio": {"type": "textarea", "group": "couple", "label": "About the groom", "max_length": 300, "sample": "A calm engineer with a big heart, who never says no to biryani or a cricket match."},
    "groom_instagram": {"type": "url", "group": "couple", "label": "Groom Instagram link (optional)"},
    "groom_facebook": {"type": "url", "group": "couple", "label": "Groom Facebook link (optional)"},
    "couple_photo": {"type": "image", "group": "couple", "label": "Couple photo"},
    "story_1_date": {"type": "text", "group": "story", "label": "Story 1 · date", "max_length": 30, "sample": "15 June, 2019"},
    "story_1_title": {"type": "text", "group": "story", "label": "Story 1 · title", "max_length": 40, "sample": "How We Met"},
    "story_1_text": {"type": "textarea", "group": "story", "label": "Story 1 · text", "max_length": 400, "sample": "We first met at a friend's wedding in Madurai. One conversation over dinner turned into hours of talking."},
    "story_1_photo": {"type": "image", "group": "story", "label": "Story 1 · photo"},
    "story_2_date": {"type": "text", "group": "story", "label": "Story 2 · date", "max_length": 30, "sample": "02 Nov, 2023"},
    "story_2_title": {"type": "text", "group": "story", "label": "Story 2 · title", "max_length": 40, "sample": "He Proposed, I Said Yes"},
    "story_2_text": {"type": "textarea", "group": "story", "label": "Story 2 · text", "max_length": 400, "sample": "On a quiet beach at sunset, with a ring and a very nervous smile, he asked the big question."},
    "story_2_photo": {"type": "image", "group": "story", "label": "Story 2 · photo"},
    "story_3_date": {"type": "text", "group": "story", "label": "Story 3 · date", "max_length": 30, "sample": "15 Apr, 2025"},
    "story_3_title": {"type": "text", "group": "story", "label": "Story 3 · title", "max_length": 40, "sample": "Our Engagement Day"},
    "story_3_text": {"type": "textarea", "group": "story", "label": "Story 3 · text", "max_length": 400, "sample": "Surrounded by our families, we exchanged rings and blessings for the journey ahead."},
    "story_3_photo": {"type": "image", "group": "story", "label": "Story 3 · photo"},
    "gallery_images": {"type": "image_multiple", "group": "gallery", "label": "Gallery photos", "max": 9},
    "person_1_name": {"type": "text", "group": "people", "label": "Person 1 · name", "max_length": 30, "sample": "Priya"},
    "person_1_role": {"type": "text", "group": "people", "label": "Person 1 · relation", "max_length": 30, "sample": "Bride's Sister"},
    "person_1_photo": {"type": "image", "group": "people", "label": "Person 1 · photo"},
    "person_2_name": {"type": "text", "group": "people", "label": "Person 2 · name", "max_length": 30, "sample": "Karthik"},
    "person_2_role": {"type": "text", "group": "people", "label": "Person 2 · relation", "max_length": 30, "sample": "Groom's Brother"},
    "person_2_photo": {"type": "image", "group": "people", "label": "Person 2 · photo"},
    "person_3_name": {"type": "text", "group": "people", "label": "Person 3 · name", "max_length": 30, "sample": "Divya"},
    "person_3_role": {"type": "text", "group": "people", "label": "Person 3 · relation", "max_length": 30, "sample": "Bride's Friend"},
    "person_3_photo": {"type": "image", "group": "people", "label": "Person 3 · photo"},
    "person_4_name": {"type": "text", "group": "people", "label": "Person 4 · name", "max_length": 30, "sample": "Arun"},
    "person_4_role": {"type": "text", "group": "people", "label": "Person 4 · relation", "max_length": 30, "sample": "Groom's Friend"},
    "person_4_photo": {"type": "image", "group": "people", "label": "Person 4 · photo"},
    "rsvp_whatsapp": {"type": "text", "group": "rsvp", "label": "WhatsApp number for RSVPs", "max_length": 20, "sample": "+91 98765 43210", "hint": "Guests' replies open WhatsApp with a ready message to this number. Leave empty to hide the RSVP form."},
    "rsvp_note": {"type": "text", "group": "rsvp", "label": "RSVP note", "max_length": 120, "sample": "We Will Be Very Happy if You Join Our Big Day. Kindly reply by 20 February."},
    "event_1_title": {"type": "text", "group": "events", "label": "Event 1 · name", "max_length": 30, "sample": "The Reception"},
    "event_1_date": {"type": "date", "group": "events", "label": "Event 1 · date", "no_countdown": true, "sample": "2027-03-12"},
    "event_1_time": {"type": "text", "group": "events", "label": "Event 1 · time", "max_length": 40, "sample": "6:30 PM – 10:00 PM"},
    "event_1_location": {"type": "location", "group": "events", "label": "Event 1 · venue & address", "sample": "Casa Blanca Estate, Assagao, North Goa"},
    "event_1_map": {"type": "map", "group": "events", "label": "Event 1 · Google Maps link", "for": "event_1_location"},
    "event_1_photo": {"type": "image", "group": "events", "label": "Event 1 · photo"},
    "event_2_title": {"type": "text", "group": "events", "label": "Event 2 · name", "max_length": 30, "sample": "The Muhurtham"},
    "event_2_date": {"type": "date", "group": "events", "label": "Event 2 · date", "no_countdown": true, "sample": "2027-03-13"},
    "event_2_time": {"type": "text", "group": "events", "label": "Event 2 · time", "max_length": 40, "sample": "6:00 AM – 7:30 AM"},
    "event_2_location": {"type": "location", "group": "events", "label": "Event 2 · venue & address", "sample": "Casa Blanca Estate, Assagao, North Goa"},
    "event_2_map": {"type": "map", "group": "events", "label": "Event 2 · Google Maps link", "for": "event_2_location"},
    "event_2_photo": {"type": "image", "group": "events", "label": "Event 2 · photo"},
    "event_3_title": {"type": "text", "group": "events", "label": "Event 3 · name", "max_length": 30, "sample": "Wedding Lunch"},
    "event_3_date": {"type": "date", "group": "events", "label": "Event 3 · date", "no_countdown": true, "sample": "2027-03-13"},
    "event_3_time": {"type": "text", "group": "events", "label": "Event 3 · time", "max_length": 40, "sample": "12:00 PM – 3:00 PM"},
    "event_3_location": {"type": "location", "group": "events", "label": "Event 3 · venue & address", "sample": "Casa Blanca Estate, Assagao, North Goa"},
    "event_3_map": {"type": "map", "group": "events", "label": "Event 3 · Google Maps link", "for": "event_3_location"},
    "event_3_photo": {"type": "image", "group": "events", "label": "Event 3 · photo"},
    "cta_title": {"type": "text", "group": "closing", "label": "Closing heading", "max_length": 50, "sample": "We Can't Wait To See You"},
    "cta_text": {"type": "text", "group": "closing", "label": "Closing text", "max_length": 140, "sample": "We Will Be Very Happy if You Join Our Big Day. We are Waiting For You."},
    "cta_background": {"type": "image", "group": "closing", "label": "Closing background photo"},
    "thanks_title": {"type": "text", "group": "closing", "label": "Footer heading", "max_length": 30, "sample": "Thank You"},
    "thanks_text": {"type": "text", "group": "closing", "label": "Footer text", "max_length": 40, "sample": "For Being With Us"},
    "footer_background": {"type": "image", "group": "closing", "label": "Footer background photo (wide)"}
  },
  "locked_fields": ["colors", "fonts", "animations", "layout"]
}
