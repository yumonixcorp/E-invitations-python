# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Gmail SMTP (use an App Password). Leave blank to print OTPs to the console.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Netlify personal access token (User settings -> Applications -> Personal access tokens)
NETLIFY_TOKEN=

# Razorpay (Dashboard -> Account & Settings -> API Keys). Leave blank to disable payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
